@model Edu_pro.Models.DashboardAnalytics
@{
    ViewData["Title"] = "Course Analytics";
    
    // Calculate completion rate safely
    var avgCompletionRate = Model.TopCourses != null && Model.TopCourses.Any() 
        ? Model.TopCourses.Average(c => c.CompletionRate).ToString("N1")
        : "0.0";
}

<link href="https://cdn.jsdelivr.net/npm/chart.js@3.7.1/dist/chart.min.css" rel="stylesheet">

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center">
        <h1 class="mt-4">Course Analytics Dashboard</h1>
        <button id="refreshData" class="btn btn-outline-success">
            <i class="fas fa-sync-alt"></i> Refresh Data
        </button>
    </div>
    
    <!-- Summary Cards -->
    <div class="row mt-4">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white mb-4">
                <div class="card-body">
                    <h4>Total Students</h4>
                    <h2 id="totalStudents">@(Model.TotalStudents)</h2>
                    <small class="text-white-50">Across all courses</small>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white mb-4">
                <div class="card-body">
                    <h4>Active Enrollments</h4>
                    <h2 id="activeEnrollments">@(Model.ActiveEnrollments)</h2>
                    <small class="text-white-50">Current period</small>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-warning text-white mb-4">
                <div class="card-body">
                    <h4>Total Revenue</h4>
                    <h2 id="totalRevenue">$@(Model.TotalRevenue.ToString("N0"))</h2>
                    <small class="text-white-50">All time</small>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-info text-white mb-4">
                <div class="card-body">
                    <h4>Avg. Completion Rate</h4>
                    <h2 id="completionRate">@avgCompletionRate%</h2>
                    <small class="text-white-50">All courses</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row">
        <div class="col-xl-6">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-chart-bar me-1"></i>
                    Monthly Enrollments
                </div>
                <div class="card-body">
                    <canvas id="enrollmentTrendChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-chart-pie me-1"></i>
                    Revenue by Category
                </div>
                <div class="card-body">
                    <canvas id="revenuePieChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Top Courses Table -->
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-table me-1"></i>
            Top Performing Courses
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Course Name</th>
                            <th>Enrollments</th>
                            <th>Completion Rate</th>
                            <th>Average Rating</th>
                            <th>Revenue</th>
                            <th>Last Updated</th>
                        </tr>
                    </thead>
                    <tbody id="topCoursesBody">
                        @if (Model.TopCourses != null && Model.TopCourses.Any())
                        {
                            @foreach (var course in Model.TopCourses)
                            {
                                <tr>
                                    <td>@course.CourseName</td>
                                    <td>@course.EnrollmentCount</td>
                                    <td>@course.CompletionRate%</td>
                                    <td>@course.AverageRating/5.0</td>
                                    <td>$@course.Revenue.ToString("N0")</td>
                                    <td>@course.LastUpdated.ToString("MMM dd, yyyy")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center">No courses available</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.7.1/dist/chart.min.js"></script>
    <script>
        let enrollmentChart;
        let revenueChart;

        function initializeCharts() {
            const monthlyCtx = document.getElementById('enrollmentTrendChart');
            const monthlyData = @Json.Serialize(Model.EnrollmentsByMonth ?? new Dictionary<string, int>());
            
            enrollmentChart = new Chart(monthlyCtx, {
                type: 'bar',
                data: {
                    labels: Object.keys(monthlyData),
                    datasets: [{
                        label: 'Monthly Enrollments',
                        data: Object.values(monthlyData),
                        backgroundColor: 'rgba(40, 167, 69, 0.5)',
                        borderColor: 'rgb(40, 167, 69)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });

            const revenueCtx = document.getElementById('revenuePieChart');
            const categoryData = @Json.Serialize(Model.EnrollmentsByCategory ?? new Dictionary<string, int>());
            
            revenueChart = new Chart(revenueCtx, {
                type: 'pie',
                data: {
                    labels: Object.keys(categoryData),
                    datasets: [{
                        data: Object.values(categoryData),
                        backgroundColor: [
                            'rgba(40, 167, 69, 0.8)',
                            'rgba(32, 201, 151, 0.8)',
                            'rgba(23, 162, 184, 0.8)',
                            'rgba(255, 193, 7, 0.8)',
                            'rgba(220, 53, 69, 0.8)'
                        ]
                    }]
                },
                options: {
                    responsive: true
                }
            });
        }

        function updateDashboard() {
            fetch('/Admin/GetAnalyticsData')
                .then(response => response.json())
                .then(data => {
                    if (data.error) {
                        console.error('Error:', data.error);
                        return;
                    }

                    // Update summary cards
                    document.getElementById('totalStudents').textContent = data.totalStudents;
                    document.getElementById('activeEnrollments').textContent = data.activeEnrollments;
                    document.getElementById('totalRevenue').textContent = '$' + data.totalRevenue.toLocaleString();
                    
                    // Update charts
                    if (enrollmentChart && data.enrollmentTrend) {
                        enrollmentChart.data.labels = data.enrollmentTrend.map(d => d.month);
                        enrollmentChart.data.datasets[0].data = data.enrollmentTrend.map(d => d.count);
                        enrollmentChart.update();
                    }
                    
                    if (revenueChart && data.revenueByCategory) {
                        revenueChart.data.labels = data.revenueByCategory.map(d => d.category);
                        revenueChart.data.datasets[0].data = data.revenueByCategory.map(d => d.revenue);
                        revenueChart.update();
                    }

                    // Update top courses table
                    const tbody = document.getElementById('topCoursesBody');
                    if (data.topCourses && data.topCourses.length > 0) {
                        tbody.innerHTML = data.topCourses.map(course => `
                            <tr>
                                <td>${course.name}</td>
                                <td>${course.count}</td>
                                <td>${course.completionRate.toFixed(1)}%</td>
                                <td>${course.rating.toFixed(1)}/5.0</td>
                                <td>$${course.revenue.toLocaleString()}</td>
                                <td>${new Date().toLocaleDateString()}</td>
                            </tr>
                        `).join('');
                    } else {
                        tbody.innerHTML = '<tr><td colspan="6" class="text-center">No courses available</td></tr>';
                    }
                })
                .catch(error => {
                    console.error('Error updating dashboard:', error);
                });
        }

        // Initialize charts on page load
        document.addEventListener('DOMContentLoaded', function() {
            initializeCharts();

            // Set up refresh button
            document.getElementById('refreshData').addEventListener('click', updateDashboard);

            // Auto-refresh every 5 minutes
            setInterval(updateDashboard, 300000);
        });
    </script>
} 